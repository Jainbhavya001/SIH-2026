# Copy this file to `.env` and adjust as needed. All values have sane
# defaults in app/config.py, so an empty .env is fine to start with.

APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Full path to tesseract.exe if it's not on your PATH, e.g. on Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

MAX_UPLOAD_MB=12

# Tampering detection tuning
ELA_JPEG_QUALITY=90
ELA_SUSPICION_THRESHOLD=18.0
COPY_MOVE_MATCH_THRESHOLD=12

# Face verification
FACE_MATCH_THRESHOLD=0.55

# Risk engine weights (should sum to 1.0)
WEIGHT_VALIDATION=0.35
WEIGHT_TAMPERING=0.40
WEIGHT_FACE=0.25

RISK_CLEAR_MAX=30
RISK_REVIEW_MAX=65
